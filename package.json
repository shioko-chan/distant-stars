{
  "name": "distant-stars",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "music:render": "node scripts/music/render.mjs",
    "music:export": "node scripts/music/export-score.mjs",
    "unreal:build": "node scripts/unreal/tool.mjs build",
    "unreal:prepare": "node scripts/unreal/tool.mjs prepare",
    "unreal:run": "node scripts/unreal/tool.mjs run",
    "unreal:package": "npm run build && node scripts/unreal/tool.mjs package",
    "unreal:verify-assets": "python scripts/unreal/verify-assets.py",
    "unreal:test": "node scripts/unreal/tool.mjs test",
    "unreal:play": "node scripts/unreal/tool.mjs play"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "vitest": "2.1.9"
  }
}
